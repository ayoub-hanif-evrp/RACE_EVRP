# Canonical text line endings for reproducible checksums across platforms.
* text=auto eol=lf
*.csv text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.txt text eol=lf

# Keep binary artifacts binary.
*.png binary
*.parquet binary
*.gpkg binary
*.graphml binary
*.pbf binary
*.xlsx binary
